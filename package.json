{
  "name": "orbis-reader",
  "version": "0.1.2",
  "description": "Read, listen to and annotate ebooks in your Obsidian vault, and make your reading part of your knowledge base.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "lint:obsidian": "tsx scripts/check-obsidian.ts",
    "lint:md": "markdownlint \"docs/**/*.md\" README.md CHANGELOG.md",
    "lint:i18n": "tsx scripts/check-i18n.ts",
    "lint:a11y": "tsx scripts/check-a11y.ts",
    "build:wordnet": "tsx scripts/build-wordnet.ts",
    "build:webster": "tsx scripts/build-webster.ts",
    "bump": "tsx scripts/bump-version.ts",
    "test": "vitest run --reporter=default --reporter=json --outputFile.json=.vitest-last-run.json",
    "test:watch": "vitest",
    "lint:size": "tsx scripts/check-size.ts",
    "lint:orphans": "tsx scripts/check-orphans.ts",
    "lint:vocab": "tsx scripts/check-vocabulary.ts",
    "lint:links": "tsx scripts/check-links.ts",
    "lint:keyboard": "tsx scripts/check-keyboard.ts",
    "lint:workflows": "tsx scripts/check-workflows.ts",
    "build:hostile-epub": "tsx scripts/make-hostile-epub.ts",
    "build:link-epub": "tsx scripts/make-link-epub.ts",
    "build:frame-navigation-epub": "tsx scripts/make-frame-navigation-epub.ts",
    "build:contrast-epub": "tsx scripts/make-contrast-epub.ts",
    "build:stylesheet-epub": "tsx scripts/make-stylesheet-epub.ts",
    "build:fixtures": "tsx scripts/build-fixtures.ts",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "keywords": ["ebook", "epub", "obsidian", "foliate", "orbis"],
  "author": "Rob Stewart",
  "homepage": "https://guide.orbisreader.com/",
  "license": "MIT",
  "packageManager": "pnpm@12.18.0",
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@types/node": "^26.6.6",
    "@types/turndown": "^5.0.6",
    "@typescript/native": "npm:typescript@^7.0.2",
    "esbuild": "0.28.2",
    "eslint": "^10.14.0",
    "eslint-plugin-obsidianmd": "^0.5.1",
    "jsdom": "^31.0.0",
    "markdownlint-cli": "^0.50.0",
    "obsidian": "1.14.4",
    "tsx": "4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.1",
    "vitepress": "1.6.4",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "1.1.1",
    "browser-id3-writer": "6.4.0",
    "construct-style-sheets-polyfill": "3.1.0",
    "diff": "9.0.0",
    "fflate": "0.8.3",
    "foliate-js": "link:src/vendor/foliate-js",
    "lamejs": "link:src/vendor/lamejs",
    "onnxruntime-web": "1.18.0",
    "pdf-lib": "1.17.1",
    "turndown": "7.2.5"
  }
}
