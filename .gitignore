# Root build artifacts
main.js

# The documentation site as `pnpm docs:build` writes it, and VitePress's cache
docs/.vitepress/dist/
docs/.vitepress/cache/

# Deployed plugin build + runtime data in the test vault (populated by deploy.sh) — all artifacts
test-vault/.obsidian/plugins/
test-vault/.obsidian/appearance.json

# Obsidian runtime files (not useful to commit)
test-vault/.obsidian/workspace.json
test-vault/.obsidian/workspace-mobile.json
test-vault/.obsidian/themes
test-vault/.obsidian/cache
test-vault/.obsidian/graph.json
test-vault/Library
test-vault/notes

# Test vault runtime data — generated by opening books, not source
test-vault/fixtures/!orbis-data/
# What converting the sample notes writes: the books, a folder's book-per-note set, and their sidecars
test-vault/fixtures/notes-to-epub/**/*.epub
test-vault/fixtures/notes-to-epub/**/*-EPUB/
test-vault/fixtures/notes-to-epub/**/!orbis-data/

# Books downloaded while testing book sources, and the sidecars reading them writes. Test data by definition: nothing
# in the suite reads them, they are re-fetchable in two taps, and six of them went into a commit before this line did.
test-vault/ebooks/

# Reading-records output in the test vault — written by testing the feature, not source. Reset with the
# "Reset reading records (dev)" command, which is why none of it is worth keeping.
test-vault/my-records/
test-vault/Reading records/
test-vault/**/*-reading-records/

# Markdown → EPUB test corpus: copies of docs/design/, so tracking them would duplicate the repo in itself
test-vault/linked-notes-test/
test-vault/*.epub
# Marks-to-PDF output — generated by testing the feature, not source
test-vault/**/*.pdf
test-vault/*-EPUB/
test-vault/orbis-reader-design-epubs/
test-vault/!orbis-data/

# Lock file — pnpm-lock.yaml is the canonical lockfile; ignore npm's
package-lock.json

